{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ubereatssri"
		},
		"FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ubereatsrisstorage.dfs.core.windows.net/"
		},
		"FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "\\\\DESKTOP-P63LGSO\\UberEats"
		},
		"FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-P63LGSO\\admin"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://ubereatskeyvalut.vault.azure.net/"
		},
		"LS_restapi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ubereats-mock-api.onrender.com"
		},
		"ls_sql_control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcareindia.database.windows.net"
		},
		"ls_sql_control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-8995565"
		},
		"ls_sql_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcareindia.database.windows.net"
		},
		"ls_sql_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-8995565"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ubereatssri_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"FileServer1_password": {
						"value": "[parameters('FileServer1_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"ls_sql_control_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_control_properties_typeProperties_server')]"
					},
					"ls_sql_control_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_control_properties_typeProperties_database')]"
					},
					"ls_sql_database_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_server')]"
					},
					"ls_sql_database_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_database')]"
					},
					"FileServer1_properties_typeProperties_host": {
						"value": "[parameters('FileServer1_properties_typeProperties_host')]"
					},
					"FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('FileServer1_properties_typeProperties_userId')]"
					},
					"LS_restapi_properties_typeProperties_url": {
						"value": "[parameters('LS_restapi_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}