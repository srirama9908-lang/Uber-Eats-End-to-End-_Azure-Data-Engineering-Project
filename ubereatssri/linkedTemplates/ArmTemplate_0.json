							"body": {
								"status": "SUCCESS",
								"message": "SQL incremental pipeline completed successfully"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-09-02T07:33:55Z"
			},
